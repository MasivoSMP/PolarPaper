@@ -0,0 +1,133 @@
+package io.canvasmc.canvas.world;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.scheduling.NewChunkHolder;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.concurrent.CompletableFuture;
+import net.minecraft.server.level.ServerLevel;
+import org.bukkit.Bukkit;
+import org.bukkit.Material;
+import org.bukkit.World;
+import org.bukkit.WorldCreator;
+import org.bukkit.WorldType;
+import org.bukkit.craftbukkit.CraftWorld;
+import org.bukkit.entity.ArmorStand;
+import org.bukkit.generator.ChunkGenerator;
+import org.bukkit.plugin.java.JavaPlugin;
+
+/** Disposable-server test only: creates worlds and stops the server. Not a production plugin. */
+public final class EphemeralStorageIntegrationPlugin extends JavaPlugin {
+    private int assertions;
+
+    @Override public void onEnable() {
+        Bukkit.getGlobalRegionScheduler().execute(this, () -> {
+            try {
+                World world = new WorldCreator("ephemeral_capability_test").type(WorldType.FLAT)
+                    .generator(new EphemeralVoid()).createWorld();
+                check(((CraftWorld) world).getHandle().canvas$isEphemeral(), "immutable capability enabled");
+                Path folder = world.getWorldFolder().toPath();
+                populate(world, true).thenCompose(ignored -> unload(world, false)).thenCompose(ignored -> {
+                    check(noContent(folder), "forced regional shutdown left no world content files");
+                    return onGlobal(() -> {
+                        World persistent = new WorldCreator("persistent_capability_test").type(WorldType.FLAT)
+                            .generator(new VoidGenerator()).createWorld();
+                        check(!((CraftWorld) persistent).getHandle().canvas$isEphemeral(), "normal world remains persistent");
+                        return persistent;
+                    });
+                }).thenCompose(persistent -> {
+                    Path persistentFolder = persistent.getWorldFolder().toPath();
+                    return populate(persistent, false).thenCompose(ignored -> unload(persistent, true)).thenAccept(ignored ->
+                        check(!noContent(persistentFolder), "normal world still writes region content"));
+                }).whenComplete((ignored, failure) -> finish(failure));
+            } catch (Throwable failure) { finish(failure); }
+        });
+    }
+
+    private CompletableFuture<Void> populate(World world, boolean ephemeral) {
+        return world.getChunkAtAsync(32, 32).thenCompose(chunk -> {
+            CompletableFuture<Void> result = new CompletableFuture<>();
+            Bukkit.getRegionScheduler().execute(this, world, 32, 32, () -> {
+                try {
+                    world.getBlockAt(512, 64, 512).setType(Material.CHEST);
+                    world.getBlockAt(513, 64, 512).setType(Material.COMPOSTER);
+                    world.spawn(new org.bukkit.Location(world, 512.5, 65, 512.5), ArmorStand.class,
+                        stand -> stand.setGravity(false));
+                    ServerLevel level = ((CraftWorld) world).getHandle();
+                    NewChunkHolder holder = level.moonrise$getChunkTaskScheduler().chunkHolderManager.getChunkHolder(32, 32);
+                    check(holder.getCurrentChunk() != null, "generated chunk exists");
+                    check(holder.getEntityChunk() != null, "entity lifecycle exists");
+                    check(holder.getPoiChunk() != null, "POI lifecycle exists");
+                    if (ephemeral) {
+                        var saved = holder.save(true);
+                        check(saved == null || (!saved.savedChunk() && !saved.savedEntityChunk() && !saved.savedPoiChunk()),
+                            "native shutdown save skips all content serialization");
+                        level.getChunkSource().getDataStorage().scheduleSave().join();
+                        check(noContent(world.getWorldFolder().toPath()), "no content before world unload");
+                    }
+                    result.complete(null);
+                } catch (Throwable failure) { result.completeExceptionally(failure); }
+            });
+            return result;
+        });
+    }
+
+    private CompletableFuture<Void> unload(World world, boolean save) {
+        CompletableFuture<Void> future = new CompletableFuture<>();
+        Bukkit.getGlobalRegionScheduler().execute(this, () -> {
+            try {
+                Bukkit.getServer().unloadWorldAsync(world, save, result -> {
+                    try {
+                        if (result.isSuccess()) {
+                            check(Bukkit.getWorld(world.getUID()) == null, "unloaded world deregistered before success");
+                            future.complete(null);
+                        } else future.completeExceptionally(new IllegalStateException("Unload failed: " + result));
+                    } catch (Throwable failure) { future.completeExceptionally(failure); }
+                });
+            } catch (Throwable failure) { future.completeExceptionally(failure); }
+        });
+        return future;
+    }
+
+    private <T> CompletableFuture<T> onGlobal(java.util.function.Supplier<T> action) {
+        CompletableFuture<T> result = new CompletableFuture<>();
+        Bukkit.getGlobalRegionScheduler().execute(this, () -> {
+            try { result.complete(action.get()); }
+            catch (Throwable failure) { result.completeExceptionally(failure); }
+        });
+        return result;
+    }
+
+    private boolean noContent(Path folder) {
+        try (var paths = Files.walk(folder)) {
+            return paths.noneMatch(path -> path.toString().endsWith(".mca") || path.toString().endsWith(".dat")
+                || path.toString().endsWith(".polar"));
+        } catch (java.io.IOException failure) { throw new java.io.UncheckedIOException(failure); }
+    }
+
+    private synchronized void check(boolean condition, String message) {
+        if (!condition) throw new AssertionError(message);
+        assertions++;
+        getLogger().info("ASSERT " + message);
+    }
+
+    private void finish(Throwable failure) {
+        String result = failure == null ? "PASS assertions=" + assertions : "FAIL " + failure;
+        if (failure != null) failure.printStackTrace();
+        getLogger().info(result);
+        try { Files.writeString(Path.of("ephemeral-capability-result.txt"), result); }
+        catch (java.io.IOException writeFailure) { writeFailure.printStackTrace(); }
+        Bukkit.getGlobalRegionScheduler().execute(this, Bukkit::shutdown);
+    }
+
+    private static class VoidGenerator extends ChunkGenerator {
+        @Override public boolean shouldGenerateNoise() { return false; }
+        @Override public boolean shouldGenerateSurface() { return false; }
+        @Override public boolean shouldGenerateBedrock() { return false; }
+        @Override public boolean shouldGenerateCaves() { return false; }
+        @Override public boolean shouldGenerateDecorations() { return false; }
+        @Override public boolean shouldGenerateMobs() { return false; }
+        @Override public boolean shouldGenerateStructures() { return false; }
+        @Override public boolean isParallelCapable() { return true; }
+    }
+    private static final class EphemeralVoid extends VoidGenerator implements EphemeralWorldGenerator {}
+}
