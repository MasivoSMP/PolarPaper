+package io.canvasmc.canvas.world;
+
+/**
+ * Opts a {@link org.bukkit.generator.ChunkGenerator} into non-persistent world content.
+ * The server snapshots this marker when constructing the world; it cannot be toggled later.
+ *
+ * <p>Chunk, entity, POI and per-world saved-data reads and writes are disabled, including
+ * autosaves, native chunk unloads, asynchronous world unloads and server shutdown.
+ * Administrative files (configuration, locks and ownership metadata) may still exist.
+ * Existing content is not a template and must not be supplied for an ephemeral world.
+ * Use a dedicated, exclusively owned world directory.</p>
+ *
+ * <p>This marker does not supply a void generator, retain unloaded chunks, remove tickets,
+ * change threading rules, or promise garbage collection. Plugins remain responsible for
+ * generation, retention and safe lifecycle coordination. Player data and external plugin
+ * storage are not covered. Failed asynchronous unloads must not be treated as permission
+ * to delete the world directory.</p>
+ */
+public interface EphemeralWorldGenerator {
+}
diff --git a/canvas-server/src/ephemeralIntegrationTest/java/io/canvasmc/canvas/world/EphemeralStorageIntegrationPlugin.java b/canvas-server/src/ephemeralIntegrationTest/java/io/canvasmc/canvas/world/EphemeralStorageIntegrationPlugin.java
