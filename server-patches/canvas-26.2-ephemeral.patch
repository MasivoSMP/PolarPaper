+package io.canvasmc.canvas.world;
+
+import io.papermc.paper.threadedregions.RegionizedServer;
+import java.util.concurrent.CompletableFuture;
+import net.minecraft.server.level.ServerLevel;
+
+/** Versioned native bridge. No Bukkit scheduler tickets or loads are needed for destruction. */
+public final class EphemeralChunkLifecycle {
+    private EphemeralChunkLifecycle() {}
+    public static int contractVersion() { return 1; }
+
+    public static CompletableFuture<String> destroyChunk(ServerLevel world, int x, int z) {
+        if (!world.canvas$isEphemeral()) return CompletableFuture.failedFuture(new IllegalArgumentException("Not ephemeral"));
+        var manager = world.moonrise$getChunkTaskScheduler().chunkHolderManager;
+        if (manager.getChunkHolder(x, z) == null) return CompletableFuture.completedFuture("ALREADY_ABSENT");
+        CompletableFuture<String> future = new CompletableFuture<>();
+        RegionizedServer.getInstance().taskQueue.queueExistingTickTask(world, x, z, () -> {
+            try {
+                if (world.canvas$unloadTicket.isPresent()) future.complete("WORLD_DESTROYING");
+                else future.complete(manager.canvas$destroyEphemeralChunk(x, z));
+            } catch (Throwable failure) { future.completeExceptionally(failure); }
+        }, () -> future.complete(manager.getChunkHolder(x, z) == null ? "ALREADY_ABSENT" : "BLOCKED"));
+        return future;
+    }
+}
