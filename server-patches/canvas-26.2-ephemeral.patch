+
+class EphemeralStorageTestSuite {
+    @TempDir Path directory;
+
+    @BeforeAll
+    static void bootstrap() {
+        SharedConstants.tryDetectVersion();
+        Bootstrap.bootStrap();
+    }
+
+    private static void field(Object target, String name, Object value) throws Exception {
+        Field field = target.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+
+    private static ServerLevel world(boolean ephemeral) {
+        ServerLevel world = mock(ServerLevel.class);
+        when(world.canvas$isEphemeral()).thenReturn(ephemeral);
+        when(world.dimension()).thenReturn(net.minecraft.world.level.Level.OVERWORLD);
+        // WorldUtil uses the Bukkit name; use a CraftWorld mock for that native getter.
+        org.bukkit.craftbukkit.CraftWorld craftWorld = mock(org.bukkit.craftbukkit.CraftWorld.class);
+        when(craftWorld.getName()).thenReturn("ephemeral-test");
+        when(world.getWorld()).thenReturn(craftWorld);
+        return world;
+    }
+
+    @Test
+    @SuppressWarnings({"unchecked", "rawtypes"})
+    void ticketlessDispatchRunsOnExistingQueueAndRetiresWithoutLoadingOrTickets() throws Exception {
+        ServerLevel world = world(true);
+        var regioniser = mock(io.papermc.paper.threadedregions.ThreadedRegionizer.class);
+        field(world, "regioniser", regioniser);
+        var worldTasks = new io.papermc.paper.threadedregions.RegionizedTaskQueue.WorldRegionTaskData(world);
+        field(world, "taskQueueRegionData", worldTasks);
+        var data = mock(io.papermc.paper.threadedregions.TickRegions.TickRegionData.class);
+        var region = mock(io.papermc.paper.threadedregions.ThreadedRegionizer.ThreadedRegion.class);
+        var queues = new io.papermc.paper.threadedregions.RegionizedTaskQueue.RegionTaskQueueData(worldTasks, data);
+        when(regioniser.getRegionAtSynchronised(12, 13)).thenReturn(region);
+        when(region.getData()).thenReturn(data);
+        when(data.getTaskQueueData()).thenReturn(queues);
+        var queue = new io.papermc.paper.threadedregions.RegionizedTaskQueue();
+        var executions = new java.util.concurrent.atomic.AtomicInteger();
+        queue.queueExistingTickTask(world, 12, 13, executions::incrementAndGet, () -> fail("Live region retired"));
+        assertEquals(0, executions.get());
+        assertTrue(queues.executeTickTask());
+        assertEquals(1, executions.get());
+
+        var retired = new java.util.concurrent.CompletableFuture<Void>();
+        queue.queueExistingTickTask(world, 12, 13, () -> fail("Retired task ran"), () -> retired.complete(null));
+        queues.retireExistingTasks();
+        retired.get(5, java.util.concurrent.TimeUnit.SECONDS);
+        when(regioniser.getRegionAtSynchronised(12, 13)).thenReturn(null);
+        var absent = new java.util.concurrent.CompletableFuture<Void>();
+        queue.queueExistingTickTask(world, 12, 13, () -> fail("Absent region ran"), () -> absent.complete(null));
+        absent.get(5, java.util.concurrent.TimeUnit.SECONDS);
+        verify(world, never()).moonrise$getChunkTaskScheduler();
+        verify(world, never()).getChunkSource();
+    }
+
+    private static ChunkTaskScheduler scheduler(ServerLevel world) throws Exception {
+        ChunkTaskScheduler scheduler = mock(ChunkTaskScheduler.class);
+        field(scheduler, "world", world);
+        field(scheduler, "ioExecutor", mock(io.canvasmc.canvas.world.chunk.ChunkSystemExecutor.class));
+        return scheduler;
+    }
+
+    @Test
+    void allRegionControllersDiscardWritesAndReadsWithoutTouchingStorage() throws Exception {
+        ServerLevel world = world(true);
+        ChunkTaskScheduler scheduler = scheduler(world);
+        EntityDataController.EntityRegionFileStorage entities = mock(EntityDataController.EntityRegionFileStorage.class);
+        var controllers = new MoonriseRegionFileIO.RegionDataController[] {
+            new ChunkDataController(world, scheduler), new PoiDataController(world, scheduler),
+            new EntityDataController(entities, scheduler)
+        };
+        for (var controller : controllers) {
+            var write = controller.startWrite(12, -13, new CompoundTag());
+            assertNull(write.output());
+            assertNull(write.write());
+            assertNull(write.input());
+            controller.finishWrite(12, -13, write);
+            var read = controller.readData(12, -13);
+            assertEquals(MoonriseRegionFileIO.RegionDataController.ReadData.ReadResult.NO_DATA, read.result());
+            assertNull(controller.finishRead(12, -13, read));
+            assertEquals(0, controller.getTotalWorkingTasks());
+        }
+        verifyNoInteractions(entities);
+        verify(world, never()).getChunkSource();
+        verify(world, never()).getPoiManager();
+    }
+
+    @Test
+    void normalControllersStillDelegateToStorage() throws Exception {
+        ServerLevel world = world(false);
+        ChunkTaskScheduler scheduler = scheduler(world);
+        EntityDataController.EntityRegionFileStorage storage = mock(EntityDataController.EntityRegionFileStorage.class);
+        for (var original : new MoonriseRegionFileIO.RegionDataController[] {
+            new ChunkDataController(world, scheduler), new PoiDataController(world, scheduler),
+            new EntityDataController(storage, scheduler)
+        }) {
+            var controller = spy(original);
+            doReturn(storage).when(controller).getCache();
+            controller.startWrite(12, -13, null);
+            controller.readData(12, -13);
+        }
+        verify(storage, times(3)).moonrise$startWrite(12, -13, null);
+        verify(storage, times(3)).moonrise$readData(12, -13);
+    }
+
+    @Test
+    void directRegionStorageCannotImportOverwriteOrDeleteExistingContent() throws Exception {
+        var info = new net.minecraft.world.level.chunk.storage.RegionStorageInfo("test", net.minecraft.world.level.Level.OVERWORLD, "entities");
+        Path folder = directory.resolve("existing");
+        var position = new net.minecraft.world.level.ChunkPos(0, 0);
+        CompoundTag original = new CompoundTag();
+        original.putString("sentinel", "unchanged");
+        try (var storage = new RegionFileStorage(info, folder, false)) {
+            storage.write(position, original);
+        }
+        Path file = folder.resolve("r.0.0.mca");
+        byte[] before = Files.readAllBytes(file);
+        try (var storage = new RegionFileStorage(info, folder, false, true)) {
+            assertNull(storage.read(position));
+            var visitor = mock(net.minecraft.nbt.StreamTagVisitor.class);
+            storage.scanChunk(position, visitor);
+            verifyNoInteractions(visitor);
+            storage.write(position, new CompoundTag());
+            storage.write(position, null);
+            var write = storage.moonrise$startWrite(0, 0, original);
+            storage.moonrise$finishWrite(0, 0, write);
+            assertNull(storage.moonrise$getRegionFileIfExists(0, 0));
+            assertThrows(IllegalStateException.class, () -> storage.getRegionFile(position));
+        }
+        assertArrayEquals(before, Files.readAllBytes(file));
+        try (var storage = new RegionFileStorage(info, folder, false)) {
+            assertEquals(original, storage.read(position));
+        }
+        Path absent = directory.resolve("absent");
+        try (var storage = new RegionFileStorage(info, absent, false, true)) {
+            storage.write(position, original);
+        }
+        assertFalse(Files.exists(absent));
+    }
+
+    @Test
+    void savedDataDoesNotSerializeOrCreateDirectoriesAndStillCloses() throws Exception {
+        Path data = directory.resolve("absent/data");
+        SavedDataStorage storage = new SavedDataStorage(data, null, mock(HolderLookup.Provider.class), true);
+        assertTrue(storage.canvas$isEphemeral());
+        assertNull(storage.get(net.minecraft.world.level.levelgen.WorldGenSettings.TYPE));
+        assertNull(storage.scheduleSave().join());
+        storage.close();
+        assertFalse(Files.exists(data));
+        assertThrows(IllegalStateException.class, storage::scheduleSave);
+        assertThrows(IllegalStateException.class, storage::close);
+        assertFalse(new SavedDataStorage(data, null, mock(HolderLookup.Provider.class)).canvas$isEphemeral());
+    }
+
+    @Test
+    void holderSkipsAllSerializationBeforeLookingAtChunkEntityOrPoiContent() throws Exception {
+        NewChunkHolder holder = mock(NewChunkHolder.class, CALLS_REAL_METHODS);
+        field(holder, "world", world(true));
+        for (Method method : NewChunkHolder.class.getDeclaredMethods()) {
+            if (!java.util.Set.of("saveChunk", "saveEntities", "savePOI").contains(method.getName())) continue;
+            method.setAccessible(true);
+            assertEquals(false, method.invoke(holder, null, true, null), method.getName());
+        }
+    }
+
+    private static Throwable close(ChunkHolderManager manager, boolean first) throws InterruptedException {
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        Thread thread = new io.papermc.paper.threadedregions.RegionShutdownThread("ephemeral-close-test") {
+            @Override public void run() {
+                try { manager.close(false, true, first, !first, false); }
+                catch (Throwable thrown) { failure.set(thrown); }
+            }
+        };
+        thread.start();
+        thread.join(10000);
+        assertFalse(thread.isAlive(), "native close must not hang");
+        return failure.get();
+    }
+
+    @Test
+    void schedulerHaltFailureIsNotReportedAsSuccess() throws Exception {
+        ServerLevel world = world(true);
+        ChunkTaskScheduler scheduler = scheduler(world);
+        ChunkHolderManager manager = mock(ChunkHolderManager.class, CALLS_REAL_METHODS);
+        field(manager, "world", world);
+        field(manager, "taskScheduler", scheduler);
+        assertInstanceOf(IllegalStateException.class, close(manager, true));
+        verify(scheduler, never()).setShutdown(true);
+    }
+
+    @Test
+    void ioHaltFailureIsNotReportedAsSuccess() throws Exception {
+        ServerLevel world = world(true);
+        ChunkTaskScheduler scheduler = scheduler(world);
+        controllers(world);
+        ChunkHolderManager manager = mock(ChunkHolderManager.class, CALLS_REAL_METHODS);
+        field(manager, "world", world);
+        field(manager, "taskScheduler", scheduler);
+        assertInstanceOf(IllegalStateException.class, close(manager, false));
+        verify(scheduler, never()).setShutdown(true);
+    }
+
+    private static java.util.List<MoonriseRegionFileIO.RegionDataController> controllers(ServerLevel world) {
+        var chunks = mock(ChunkDataController.class);
+        var entities = mock(EntityDataController.class);
+        var poi = mock(PoiDataController.class);
+        when(world.moonrise$getChunkDataController()).thenReturn(chunks);
+        when(world.moonrise$getEntityChunkDataController()).thenReturn(entities);
+        when(world.moonrise$getPoiChunkDataController()).thenReturn(poi);
+        return java.util.List.of(chunks, entities, poi);
+    }
+
+    @Test
+    void cacheCloseFailuresAreAggregatedAndAllCachesAreAttempted() throws Exception {
+        ServerLevel world = world(true);
+        ChunkTaskScheduler scheduler = scheduler(world);
+        when(scheduler.haltIO(eq(true), anyLong())).thenReturn(true);
+        var controllers = controllers(world);
+        for (var controller : controllers) {
+            RegionFileStorage storage = mock(RegionFileStorage.class);
+            when(controller.getCache()).thenReturn(storage);
+            doThrow(new IOException("injected close failure")).when(storage).close();
+        }
+        ChunkHolderManager manager = mock(ChunkHolderManager.class, CALLS_REAL_METHODS);
+        field(manager, "world", world);
+        field(manager, "taskScheduler", scheduler);
+        Throwable failure = close(manager, false);
+        assertInstanceOf(java.io.UncheckedIOException.class, failure);
+        assertEquals(2, failure.getSuppressed().length);
+        for (var controller : controllers) verify(controller.getCache()).close();
+        verify(scheduler, never()).setShutdown(true);
+    }
+
+    @Test
+    void unloadCompletionCannotTurnFailureIntoSuccessOrNotifyTwice() throws Exception {
+        ServerLevel world = world(true);
+        var tickets = new io.canvasmc.canvas.util.ticket.TicketHolder<io.canvasmc.canvas.util.ticket.UnloadTicket>();
+        var results = new java.util.ArrayList<io.canvasmc.canvas.WorldUnloadResult>();
+        tickets.propagate(new io.canvasmc.canvas.util.ticket.UnloadTicket(results::add, false));
+        field(world, "canvas$unloadTicket", tickets);
+        var thread = mock(io.canvasmc.canvas.threadedregions.WorldShutdownThread.class, CALLS_REAL_METHODS);
+        field(thread, "level", world);
+        field(thread, "canvas$callbackCompleted", new java.util.concurrent.atomic.AtomicBoolean());
+        Method complete = thread.getClass().getDeclaredMethod("canvas$completeUnload", io.canvasmc.canvas.WorldUnloadResult.class);
+        complete.setAccessible(true);
+        complete.invoke(thread, io.canvasmc.canvas.WorldUnloadResult.FAIL_RESOURCE_CLOSE);
+        complete.invoke(thread, io.canvasmc.canvas.WorldUnloadResult.SUCCESS);
+        assertEquals(java.util.List.of(io.canvasmc.canvas.WorldUnloadResult.FAIL_RESOURCE_CLOSE), results);
